# Ollama endpoint. The Ollama container publishes its port on the host
# loopback, so a host-run systemd service reaches it directly.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Upstream timeout in milliseconds.
# IMPORTANT: on a CPU-only VPS a 0.5B model can take 2-4 MINUTES for a
# short answer. 120 s aborts valid requests. Raise this to 600000 on a
# CPU-only host, or lower it to 30000 if a GPU is present.
OLLAMA_TIMEOUT_MS=300000

# Port the RAG service listens on.
RAG_PORT=8001
