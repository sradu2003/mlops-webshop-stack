# --- Core ---
DATABASE_URL=postgresql+psycopg://shop:change_me_strong_password@127.0.0.1:5432/shopdb
ENVIRONMENT=development

# --- Auth ---
# MUST be changed. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# Comma-separated. Empty = no browser origin allowed (server-to-server only).
CORS_ORIGINS=https://xxx.com,https://www.xxx.com

# --- Observability ---
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Anonymous visitor pseudonymisation salt ---
# Rotate to invalidate all anonymous identifiers. Generate with: openssl rand -hex 32
ANON_SALT=change_me_anon_salt

# --- Host header validation ---
# Comma-separated allowed Host values. EMPTY = disabled.
# If you enable this, make sure your Prometheus scrape config sends a matching
# Host header, otherwise /health and /ready return 400.
ALLOWED_HOSTS=
