# --- Ollama upstream ---
# The Ollama container publishes its port on the host loopback, so a
# host-run systemd service reaches it directly at 127.0.0.1.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Upstream timeout in milliseconds.
# On a CPU-only VPS a 0.5B model can take 2-4 MINUTES for a short answer.
# 120 s aborts valid requests. Raise to 600000 on CPU-only hosts,
# or lower to 30000 when a GPU is present.
OLLAMA_TIMEOUT_MS=300000

# --- Server ---
PORT=8000
HOST=127.0.0.1

# --- Database ---
DATABASE_URL=postgres://shop:change_me_strong_password@127.0.0.1:5432/shopdb

# --- Logging ---
LOG_LEVEL=info
