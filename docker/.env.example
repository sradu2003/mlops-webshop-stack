# --- Docker stack (read by docker/docker-compose.yml) ---
# Copy to docker/.env.  cp .env.example .env  then edit.

COMPOSE_PROJECT_NAME=mlops-webshop

# --- Ollama ---
# Host port Ollama is published on. Use 11435 if 11434 is already taken
# (e.g. a native Ollama on a developer machine).
OLLAMA_HOST_PORT=11434
OLLAMA_MEMORY_LIMIT=1800m
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TAG=latest

# --- Open WebUI ---
OPEN_WEBUI_HOST_PORT=8085
OPEN_WEBUI_MEMORY_LIMIT=1200m
OPEN_WEBUI_TAG=main
OPEN_WEBUI_DB_NAME=openwebui
# Vector store: pgvector | chroma | qdrant | milvus | valkey
OPEN_WEBUI_VECTOR_DB=pgvector

# --- Postgres (listmonk + openwebui) ---
POSTGRES_TAG=pg16
LISTMONK_DB_USER=shop
LISTMONK_DB_PASSWORD=change_me_listmonk_password
LISTMONK_DB_NAME=shopdb
LISTMONK_HOST_PORT=9000
LISTMONK_TAG=latest

# --- Grafana ---
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_ROOT_URL=https://grafana.xxx.com
GRAFANA_TAG=latest

# --- Prometheus ---
PROMETHEUS_HOST_PORT=9091
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
PROMETHEUS_TAG=latest

# --- node-exporter ---
NODE_EXPORTER_TAG=latest

# --- Model served by Ollama ---
OLLAMA_MODEL=qwen2.5:0.5b
