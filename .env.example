# ==============================================================================
# mlops-webshop-stack — root environment template
# ==============================================================================
# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env  (it is git-ignored).
# This file is sourced by scripts/init_databases.sh and is the single source of
# truth for the native (non-Docker) services.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain / TLS
# ------------------------------------------------------------------------------
# Your apex domain. Wildcard DNS A record must point at the VPS public IP.
DOMAIN=xxx.com
# Contact address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=admin@xxx.com

# ------------------------------------------------------------------------------
# PostgreSQL — primary application database
# (used by the Python API, the Node API and the RAG service)
# ------------------------------------------------------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=shopdb
# Host-side DSN used by apps running on the host (systemd units).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Full DSN — apps use this directly.
DATABASE_URL=postgresql+psycopg://shop:change_me_strong_password@127.0.0.1:5432/shopdb

# ------------------------------------------------------------------------------
# MariaDB — WordPress database
# ------------------------------------------------------------------------------
MARIADB_DATABASE=wordpress
MARIADB_USER=wpuser
MARIADB_PASSWORD=change_me_strong_password

# ------------------------------------------------------------------------------
# Python API (FastAPI) — apps/python-api/.env.example
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Empty = no browser origins
# allowed (safe default; the API is server-to-server behind nginx).
CORS_ORIGINS=https://xxx.com,https://www.xxx.com
# MUST be changed. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret
# Prometheus metrics path. Requires prometheus-fastapi-instrumentator.
METRICS_ENABLED=true
# Salt used to pseudonymise anonymous visitors (HMAC of IP + User-Agent).
# MUST be changed. Generate with: openssl rand -hex 32
# scripts/30_install_apps.sh generates one on first run if this is left
# as a placeholder, and persists it back into this file.
ANON_SALT=change_me_anon_salt
# Host-header validation for the API. EMPTY = disabled (the default).
# If you enable it, the Prometheus scrape config must send a matching Host
# header, otherwise /health and /ready return 400.
ALLOWED_HOSTS=
# Runtime environment for the API: development | staging | production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Node API — apps/node-api/.env.example
# ------------------------------------------------------------------------------
NODE_PORT=8000
NODE_DATABASE_URL=postgres://shop:change_me_strong_password@127.0.0.1:5432/shopdb

# ------------------------------------------------------------------------------
# Next.js RAG — apps/nextjs-rag/.env.example
# ------------------------------------------------------------------------------
# Ollama is published on the host loopback, so host-run apps reach it directly.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
RAG_PORT=8001

# ------------------------------------------------------------------------------
# Streamlit — apps/streamlit-app/.env.example
# ------------------------------------------------------------------------------
STREAMLIT_PORT=3001
API_BASE=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Docker stack (docker/.env) — read by docker/docker-compose.yml
# ------------------------------------------------------------------------------
# Host port Ollama is published on. Change if 11434 is taken on the VPS.
OLLAMA_HOST_PORT=11434
# Hard memory ceiling for the Ollama container.
OLLAMA_MEMORY_LIMIT=1800m
# Grafana admin. CHANGE BOTH.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
# Listmonk database password. CHANGE.
LISTMONK_DB_PASSWORD=change_me_listmonk_password
LISTMONK_ADMIN_USER=listmonk
LISTMONK_ADMIN_PASSWORD=change_me_listmonk_password
# Where docker/.env is read from (the compose file lives in docker/).
COMPOSE_PROJECT_NAME=mlops-webshop
